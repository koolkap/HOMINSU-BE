# Backend service variables. Add these in Railway Variables; do not commit
# real secrets. Replace service names if your Railway services use different names.
DEBUG=false
SECRET_KEY=generate-a-long-random-secret-in-railway
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Copy the Supabase Connect Session Pooler URI here. This is a PostgreSQL
# connection string, not SUPABASE_URL. Use the session pooler for this long-
# running FastAPI service and keep the password sealed in Railway.
DATABASE_URL=postgresql+asyncpg://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-<REGION>.pooler.supabase.com:5432/postgres

SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<PUBLIC_KEY>
SUPABASE_SECRET_KEY=sb_secret_<SET_AS_A_SEALED_RAILWAY_VARIABLE>
SUPABASE_JWKS_URL=https://<PROJECT_REF>.supabase.co/auth/v1/.well-known/jwks.json

# Reference the SRS service's public HTTP domain. This is used in generated
# HLS media URLs returned by the API.
SRS_HLS_BASE_URL=https://${{SRS.RAILWAY_PUBLIC_DOMAIN}}

# Use your deployed frontend's exact HTTPS origin(s). JSON syntax is required.
CORS_ORIGINS=["https://your-frontend.example.com"]

# SRS service variables. Add these to the SRS service, not the Backend service.
# Railway resolves this reference to the Backend's private hostname and port.
SRS_HOOK_BASE_URL=http://${{Backend.RAILWAY_PRIVATE_DOMAIN}}:${{Backend.PORT}}/api/v1/srs
