FLASK_APP=app:create_app
FLASK_ENV=development
DATABASE_URL=postgresql+psycopg://hominsu:hominsu_dev_password@localhost:5432/hominsu
JWT_SECRET_KEY=replace-with-a-long-random-development-secret
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-a-server-only-secret-key
SUPABASE_STORAGE_BUCKET=hominsu
STORAGE_MAX_FILE_SIZE=52428800
STORAGE_PROVIDER=s3
AWS_ENDPOINT_URL_S3=https://your-project.storage.supabase.co/storage/v1/s3
AWS_DEFAULT_REGION=ap-south-1
AWS_ACCESS_KEY_ID=replace-with-s3-access-key
AWS_SECRET_ACCESS_KEY=replace-with-s3-secret-key
S3_BUCKET=hominsu
